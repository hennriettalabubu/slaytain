# dhi-aio-studio — shell goodies sourced from ~/.zshrc tail.
# Covers: zplug extras, fzf, eza, nvm, aliases, brew shellenv.
# No secrets here. Keep credentials in runtime env or ~/.zshrc.local.

# --- zplug extras (loaded ON TOP of the base .zshrc zplug block) ---
if [[ -z "${_DHI_ZPLUG_EXTRAS_LOADED:-}" ]]; then
  export _DHI_ZPLUG_EXTRAS_LOADED=1
  zplug "b4b4r07/enhancd", use:init.sh
  zplug "mollifier/anyframe"
  zplug "mollifier/cd-gitroot"
  zplug check || zplug install
  zplug load
fi

# --- fzf: Ctrl-R history / Ctrl-T files / Alt-C cd / **<Tab> completion ---
if [[ -r /usr/share/doc/fzf/examples/key-bindings.zsh ]]; then
  source /usr/share/doc/fzf/examples/key-bindings.zsh
  source /usr/share/doc/fzf/examples/completion.zsh
fi

# --- eza instead of ls (icons expect a Nerd Font on the host terminal) ---
if (( $+commands[eza] )); then
  alias ls='eza --group-directories-first --icons'
  alias ll='eza -l --group-directories-first --icons --git'
  alias la='eza -la --group-directories-first --icons --git'
  alias lt='eza --tree --level=2 --icons'
fi

# --- nvm (installed per-user by Dockerfile) ---
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# --- gcloud (installed by Dockerfile at $HOME/google-cloud-sdk) ---
[ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]       && . "$HOME/google-cloud-sdk/path.zsh.inc"
[ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ] && . "$HOME/google-cloud-sdk/completion.zsh.inc"

# --- aliases ---
alias zource='source ~/.zshrc'
alias grade='sudo apt update && sudo apt upgrade -y'
alias wrangler='npx wrangler'

# --- user-local overrides (secrets, host-specific tweaks) ---
# Put FAL_KEY, CLOUDFLARE_*, GEMINI_API_KEY, etc. in this file inside the
# container. It is NOT in the image; create it after SSHing in.
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
